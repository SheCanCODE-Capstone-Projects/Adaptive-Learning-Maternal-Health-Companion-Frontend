# Production settings for `npm run build`. Vite bakes these into the public
# JavaScript bundle, so never put secrets here.

# Where the browser sends API requests.
# Recommended: serve the API from the same domain under /api/v1 (a reverse
# proxy in front of the backend), which needs no CORS setup and keeps the
# offline service worker away from API traffic.
# For an API on another domain, use its full URL, for example
#   VITE_API_BASE_URL=https://api.example.org/api/v1
# and set CORS_ALLOWED_ORIGINS on the backend to this site's origin.
VITE_API_BASE_URL=/api/v1

# Shows the "Open demo account" buttons, which sign in with a shared demo
# account whose password is in the bundle. Keep it off for real users.
VITE_ENABLE_DEMO=false
